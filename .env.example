# Mẫu cấu hình radard. Chép thành `.env` rồi điền giá trị; `.env` không được commit.

# Postgres local (mặc định đã đúng cho máy dev)
# DATABASE_URL=postgres://localhost:5432/radard

# Vercel AI Gateway: Dashboard → AI Gateway → API Keys → Create Key
AI_GATEWAY_API_KEY=

# Tuỳ chọn: token GitHub chỉ quyền đọc (quota 5.000 request/giờ, 304 không bị trừ quota)
# GITHUB_TOKEN=

# Tuỳ chọn: ngưỡng lớp 2 (đã chỉnh trên dữ liệu thật 28/09/2026, đây là mặc định)
# RELEVANCE_THRESHOLD=0.58
# JOIN_THRESHOLD=0.9

# Telegram: tạo bot qua @BotFather (/newbot), rồi gửi /start cho bot.
# Người nhận KHÔNG đặt ở đây: lấy chat id từ getUpdates rồi chạy `bun run cli channels add 1 telegram <chat_id>`.
TELEGRAM_BOT_TOKEN=

# Tuỳ chọn: model sinh văn bản (mặc định anthropic/claude-haiku-5.5, $0,1/$0,5 mỗi MTok)
# LLM_MODEL=anthropic/claude-haiku-5.5

# Tuỳ chọn: nhịp gọi embedding (mặc định 1 giây). Gói miễn phí AI Gateway chỉ cho 5
# request/phút: khi đó đặt 12000.
# EMBED_MIN_INTERVAL_MS=1000
# Trần số lô (128 tài liệu) mỗi lượt job `process` của daemon; CLI `process` chạy tới hết.
# PROCESS_MAX_BATCHES=60

# Kho bản thô: `fs` (mặc định, ghi ra DATA_DIR) hoặc `r2` (Cloudflare R2, dùng trên Railway).
# OBJECT_STORE=fs
# DATA_DIR=./data
# R2: Cloudflare Dashboard → R2 → Manage API tokens → quyền Object Read & Write cho một bucket.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Vai trò của tiến trình: scheduler | worker | bot | all (mặc định all, dùng trên Railway ở MVP-0)
# SERVICE_ROLE=all

# --- Web và đăng nhập (Better Auth 1.6.23; vai trò `web`) ---
# BẮT BUỘC để bật đăng nhập: BETTER_AUTH_SECRET và BETTER_AUTH_URL. Thiếu một trong hai thì /api/* trả
# 503, daemon vẫn chạy. Các biến còn lại tuỳ chọn, nhưng không có provider nào thì không ai đăng nhập được.
# Khoá ký cookie, ít nhất 32 ký tự ngẫu nhiên: `openssl rand -base64 32`. Đổi khoá thì mọi phiên hết hiệu lực.
BETTER_AUTH_SECRET=
# Địa chỉ công khai của web, không có dấu / cuối. https thì cookie phiên có Secure; luôn HttpOnly, SameSite=Lax.
# Dev (không đặt trong NODE_ENV=production): mặc định http://localhost:$PORT. Chạy Vite thì đặt http://localhost:5173.
# BETTER_AUTH_URL=https://radard.example.com
# Email (đã xác minh) được phép KHỞI TẠO owner đầu tiên, phân tách bằng dấu phẩy (chữ hoa/thường không quan trọng).
# Chỉ có tác dụng khi DB chưa có owner nào: người đăng nhập đầu tiên trong danh sách thành owner và nhận hồ sơ
# chưa có chủ nhỏ nhất. Có owner rồi thì biến này bị bỏ qua; thêm owner sau bằng `bun run cli owners add <email>`.
# Thiếu thì không có đường khởi tạo (owner phải được tạo bằng lời mời role=owner qua CLI).
# BOOTSTRAP_OWNER_EMAILS=
# GitHub OAuth App; Authorization callback URL = <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google OAuth client (Web application); Authorized redirect URI = <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Mời người dùng: thêm email chữ thường vào bảng invites (ví dụ
# `psql "$DATABASE_URL" -c "insert into invites (email) values ('ban@example.com')"`).
