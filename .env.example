# radard configuration template. Copy to `.env` and fill in; `.env` is never committed.
# Variables with a default are commented out; uncomment only to override.

# --- Core ---
# DATABASE_URL=postgres://localhost:5432/radard
# Process role: scheduler | worker | bot | web | all (default: all)
# SERVICE_ROLE=all

# --- AI (Vercel AI Gateway: Dashboard -> AI Gateway -> API Keys) ---
AI_GATEWAY_API_KEY=
# Text model (default: anthropic/claude-haiku-5.5)
# LLM_MODEL=anthropic/claude-haiku-5.5
# Embedding call interval in ms (default 1000; the free gateway tier allows 5 requests/minute -> 12000)
# EMBED_MIN_INTERVAL_MS=1000
# Max batches per daemon `process` run (default 60)
# PROCESS_MAX_BATCHES=60
# Layer-2 thresholds (defaults tuned on real data)
# RELEVANCE_THRESHOLD=0.58
# JOIN_THRESHOLD=0.9
# Daily "For me?" answers per profile (default 100)
# FOR_ME_DAILY_LIMIT=100

# --- Sources ---
# Optional read-only GitHub token (5,000 requests/hour)
# GITHUB_TOKEN=

# --- Telegram (create the bot with @BotFather, then send it /start) ---
# Recipients are not set here: `bun run cli channels add <profile_id> telegram <chat_id>`
TELEGRAM_BOT_TOKEN=

# --- Raw copy storage ---
# fs (writes to DATA_DIR) or r2
# OBJECT_STORE=fs
# DATA_DIR=./data
# R2 (Cloudflare Dashboard -> R2 -> Manage API tokens, Object Read & Write on one bucket)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Web role ---
# PORT=8080
# Tracking links (/o/*): both are required; without them messages keep direct links
# HMAC key: `openssl rand -base64 32`
# LINK_SECRET=
# PUBLIC_BASE_URL=https://radard.example.com

# --- Sign-in (Better Auth) ---
# BETTER_AUTH_SECRET and BETTER_AUTH_URL are required; without them /api/* returns 503 (the daemon keeps running).
# At least one OAuth provider is needed for anyone to sign in.
# >= 32 random chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public address, no trailing slash. In dev with Vite: http://localhost:5173
BETTER_AUTH_URL=
# Emails (verified) allowed to create the FIRST owner, comma-separated. Ignored once any owner exists;
# add later owners with `bun run cli owners add <email>`.
BOOTSTRAP_OWNER_EMAILS=
# GitHub OAuth App; callback URL = <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (Web application); redirect URI = <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Invite users: `bun run cli invites add <email>`
