# Mẫu cấu hình radard. Chép thành `.env` rồi điền giá trị; `.env` không được commit.

# Postgres local (mặc định đã đúng cho máy dev)
# DATABASE_URL=postgres://localhost:5432/radard

# Vercel AI Gateway: Dashboard → AI Gateway → API Keys → Create Key
AI_GATEWAY_API_KEY=

# Tuỳ chọn: token GitHub chỉ quyền đọc (quota 5.000 request/giờ, 304 không bị trừ quota)
# GITHUB_TOKEN=

# Tuỳ chọn: ngưỡng lớp 2 (đã chỉnh trên dữ liệu thật 28/09/2026, đây là mặc định)
# RELEVANCE_THRESHOLD=0.58
# JOIN_THRESHOLD=0.9

# Telegram: tạo bot qua @BotFather (/newbot), rồi gửi /start cho bot.
# Người nhận KHÔNG đặt ở đây: lấy chat id từ getUpdates rồi chạy `bun run cli channels add 1 telegram <chat_id>`.
TELEGRAM_BOT_TOKEN=

# Tuỳ chọn: model sinh văn bản (mặc định anthropic/claude-haiku-5.5, $0,1/$0,5 mỗi MTok)
# LLM_MODEL=anthropic/claude-haiku-5.5

# Tuỳ chọn: nhịp gọi embedding (mặc định 1 giây). Gói miễn phí AI Gateway chỉ cho 5
# request/phút: khi đó đặt 12000.
# EMBED_MIN_INTERVAL_MS=1000
# Trần số lô (128 tài liệu) mỗi lượt job `process` của daemon; CLI `process` chạy tới hết.
# PROCESS_MAX_BATCHES=60

# Kho bản thô: `fs` (mặc định, ghi ra DATA_DIR) hoặc `r2` (Cloudflare R2, dùng trên Railway).
# OBJECT_STORE=fs
# DATA_DIR=./data
# R2: Cloudflare Dashboard → R2 → Manage API tokens → quyền Object Read & Write cho một bucket.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Vai trò của tiến trình: scheduler | worker | bot | all (mặc định all, dùng trên Railway ở MVP-0)
# SERVICE_ROLE=all
